<!DOCTYPE html>
<html>

<head>
  <title>
    <%= title %>
  </title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <script defer src="/javascripts/eventEmitter.js"></script>
  <script defer src="/javascripts/index.js"></script>
  <script defer src="/javascripts/cache.js"></script>
  <script defer src="/javascripts/modal.js"></script>

</head>

<body class="body">
  <main class="main">

    <div class="modal">
      <p class="modal__text">Что-то пошло не так...</p>
      <button class="modal__hide-btn nostyle-btn">+</button>
    </div>


    <section class="section">
      <form class="section__input-container section--second">
        <div class="slider">
          <input class="slider__input nostyle-input" name="giphy" type="text" placeholder="Введите название гифки">
          <label class="slider__label" for="slider__input">Введите название гифки</label>
          <div class="slider__bottom-line"></div>
        </div>

        <div class="slider">
          <button class="slider__button nostyle-btn" type="submit">Поиск</button>
          <div class="slider__btn-bottom-line"></div>
        </div>
      </form>

      <section class="history-section section--first">
        <ul class="history-section__list nostyle-list">
        </ul>
      </section>

      <ul class="section__result-container nostyle-list section--third">
        <li>
          <img class="img" src="" id="img" alt="Изображение с анимацией">
        </li>
        <li>
          <img class="img" src="" id="img" alt="Изображение с анимацией">
        </li>
        <li>
          <img class="img" src="" id="img" alt="Изображение с анимацией">
        </li>
        <li>
          <img class="img" src="" id="img" alt="Изображение с анимацией">
        </li>
        <li>
          <img class="img" src="" id="img" alt="Изображение с анимацией">
        </li>
        <li>
          <img class="img" src="" id="img" alt="Изображение с анимацией">
        </li>
      </ul>
    </section>
  </main>
</body>

</html>